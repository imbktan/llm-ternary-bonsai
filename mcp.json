{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://127.0.0.1:8081",
        "--output-dir",
        "/tmp/bonsai-playwright"
      ]
    }
  }
}
